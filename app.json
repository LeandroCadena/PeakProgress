{
    "expo": {
        "name": "Gym Time",
        "slug": "PeakProgress",
        "scheme": "gymtime",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "automatic",
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#171717",
                "foregroundImage": "./assets/android-icon-foreground.png",
                "monochromeImage": "./assets/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "com.leandrocadena.gymtime"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "extra": {
            "eas": {
                "projectId": "bb0b13aa-e65f-42aa-ad70-d00e1aed5561"
            }
        },
        "plugins": [
            "expo-audio",
            [
                "expo-notifications",
                {
                    "color": "#F97316",
                    "defaultChannel": "workout-rest"
                }
            ],
            "expo-sqlite"
        ]
    }
}
